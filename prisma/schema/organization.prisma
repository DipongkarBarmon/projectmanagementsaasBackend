model Organization {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  slug        String @unique
  logo        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  // invitations Invitation[]

  // teams Team[]
  // projects Project[]

  // labels Label[]

  // activities Activity[]

  // subscription Subscription?
}