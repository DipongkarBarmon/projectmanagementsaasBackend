model Organization {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  slug        String @unique
  logo        String?
  logoPublicId String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt   DateTime?
  members OrganizationMember[]

  invitations Invitation[]

  teams Team[]

  projects Project[]

  labels Label[]
}